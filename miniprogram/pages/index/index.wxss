.page { min-height: 100vh; background: #fff; }.notice { padding: 18rpx 24rpx; background: #fff7d7; color: #f09119; font-size: 28rpx; }.extract-card { display: flex; gap: 14rpx; padding: 28rpx 22rpx 14rpx; }.extract-card input { flex: 1; min-width: 0; height: 94rpx; padding: 0 18rpx; border: 2rpx solid #08bd63; border-radius: 12rpx; font-size: 28rpx; }.placeholder { color: #9ea6a2; }.extract-card button { height: 94rpx; padding: 0 20rpx; border-radius: 10rpx; color: #fff; font-size: 28rpx; font-weight: 700; line-height: 94rpx; }.primary, .paste { background: #08bd63; }.rights-note { padding: 0 22rpx 26rpx; color: #a0a6a3; text-align: center; font-size: 22rpx; }.feature-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 18rpx; padding: 0 22rpx; }.feature-grid button { display: flex; min-height: 166rpx; flex-direction: column; align-items: center; justify-content: center; gap: 12rpx; border-radius: 24rpx; background: #08bd63; color: #fff; box-shadow: 0 14rpx 22rpx rgba(2, 133, 68, .18); font-size: 26rpx; font-weight: 700; }.feature-grid button text:first-child { font-size: 54rpx; line-height: 1; }.result-card { display: flex; align-items: center; gap: 16rpx; margin: 0 22rpx 24rpx; padding: 22rpx; border-radius: 18rpx; background: #effbf5; }.result-card.limited, .result-card.error { background: #fff6e9; }.result-icon { display: grid; width: 50rpx; height: 50rpx; place-items: center; border-radius: 50%; background: #08bd63; color: #fff; font-weight: 700; }.limited .result-icon, .error .result-icon { background: #eda036; }.result-body { flex: 1; min-width: 0; }.result-title, .result-desc { display: block; }.result-title { font-size: 27rpx; font-weight: 700; }.result-desc { margin-top: 7rpx; color: #75807a; font-size: 23rpx; word-break: break-all; }.copy-result { padding: 0; background: transparent; color: #07834a; font-size: 23rpx; }
.mask { position: fixed; z-index: 20; inset: 0; display: flex; align-items: flex-end; background: rgba(10, 28, 18, .44); }.sheet { width: 100%; max-height: 70vh; overflow: auto; border-radius: 34rpx 34rpx 0 0; background: #fff; }.sheet-head { display: flex; align-items: center; justify-content: space-between; padding: 30rpx; border-bottom: 1rpx solid #eee; font-size: 33rpx; font-weight: 700; }.sheet-head text:last-child { color: #89918d; font-size: 46rpx; font-weight: 400; }.sheet-content { padding: 30rpx; color: #53605a; font-size: 28rpx; line-height: 1.8; }.sheet-content view + view { margin-top: 24rpx; }.faq view { padding-bottom: 20rpx; border-bottom: 1rpx solid #eee; }.faq text { display: block; }.faq text:first-child { color: #28322d; font-weight: 700; }.faq text:last-child { margin-top: 8rpx; color: #76817b; font-size: 25rpx; }.history-list { padding: 0 30rpx 30rpx; }.history-list button { display: flex; width: 100%; align-items: center; justify-content: space-between; padding: 24rpx 0; border-bottom: 1rpx solid #eee; background: transparent; color: #6d7972; text-align: left; }.history-list button text { display: block; }.history-list button text:first-child { color: #33413a; font-size: 28rpx; }.history-list button text:last-child { margin-top: 8rpx; color: #a0a6a2; font-size: 22rpx; }.history-list .clear { display: block; margin: 18rpx auto 0; border: 0; color: #db7059; text-align: center; }.empty { padding: 70rpx 0; color: #9ca39f; text-align: center; font-size: 27rpx; }
