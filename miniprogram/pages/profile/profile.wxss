.page { padding: 86rpx 38rpx; text-align: center; }.avatar { display: grid; width: 140rpx; height: 140rpx; place-items: center; margin: 0 auto 28rpx; border-radius: 42rpx; background: #08bd63; color: #fff; font-size: 58rpx; font-weight: 700; }.title { font-size: 38rpx; font-weight: 700; }.desc { margin: 14rpx 0 60rpx; color: #98a09c; font-size: 26rpx; }.row { display: flex; align-items: center; justify-content: space-between; padding: 28rpx 0; border-bottom: 1rpx solid #eee; text-align: left; color: #7c8681; }.row text { display: block; }.row text:first-child { color: #27332c; font-size: 29rpx; }.row text:last-child { margin-top: 8rpx; color: #9da49f; font-size: 24rpx; }.clear { margin-top: 56rpx; background: transparent; color: #db7059; font-size: 28rpx; }
